# Скопируй в .env или запусти ./scripts/start.sh: он создаст .env сам.
# Файл .env в Git не попадает, секреты не коммить.

# Порт Control на 127.0.0.1
LAB_CONTROL_PORT=8080

# Секреты: замени на случайные значения (openssl rand -hex 32).
# Роли и пароли БД создаются при первом запуске; позже правка .env их не меняет.
LAB_OPERATOR_TOKEN=replace-with-local-random-token
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=replace-with-local-admin-password
LAB_CONTROL_DB_PASSWORD=replace-with-local-control-password

# Gateway
SHOP_PROTECTED_URL=http://shop-protected:8080
GATEWAY_CONNECT_TIMEOUT=2s
GATEWAY_UPSTREAM_TIMEOUT=5s
GATEWAY_MAX_BODY_BYTES=8388608
