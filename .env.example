# Скопируй в .env или запусти ./scripts/start.sh: он создаст .env сам.
# Файл .env в Git не попадает, секреты не коммить.

# Порт Control на 127.0.0.1
LAB_CONTROL_PORT=8080

# Секреты: замени на случайные значения (openssl rand -hex 32).
# Роли и пароли БД создаются при первом запуске; позже правка .env их не меняет.
LAB_OPERATOR_TOKEN=replace-with-local-random-token
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=replace-with-local-admin-password
LAB_CONTROL_DB_PASSWORD=replace-with-local-control-password
LAB_FIXTURE_DB_PASSWORD=replace-with-local-fixture-password

LAB_FIXTURE_USER_COUNT=24
LAB_FIXTURE_CS_ATTEMPTS=200
LAB_FIXTURE_CS_VALID_ACCOUNTS=3

# Detector: independent service roles and database credentials.
LAB_DETECTOR_CONTROL_TOKEN=replace-with-local-detector-control-token
LAB_DETECTOR_GATEWAY_TOKEN=replace-with-local-detector-gateway-token
LAB_DETECTOR_SHOP_TOKEN=replace-with-local-detector-shop-token
LAB_DETECTOR_DB_PASSWORD=replace-with-local-detector-password
LAB_DETECTOR_MIGRATION_PASSWORD=replace-with-local-detector-migration-password

# Gateway
SHOP_PROTECTED_URL=http://shop-protected:8080
GATEWAY_CONNECT_TIMEOUT=2s
GATEWAY_UPSTREAM_TIMEOUT=5s
GATEWAY_MAX_BODY_BYTES=8388608

# Shop API
JWT_SECRET_PROTECTED=replace-with-protected-jwt-secret
JWT_SECRET_VULNERABLE=replace-with-vulnerable-jwt-secret
IDEMPOTENCY_SECRET=replace-with-local-idempotency-secret
