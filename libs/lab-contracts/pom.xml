<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>lab</groupId>
    <artifactId>api-security-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>lab-contracts</artifactId>
  <packaging>jar</packaging>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-http-converter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>3.0.8</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../../contracts/schemas</directory>
        <targetPath>lab/contracts/schemas</targetPath>
        <includes>
          <include>common.yaml</include>
          <include>control.yaml</include>
          <include>detector.yaml</include>
          <include>logs.yaml</include>
          <include>runtime.yaml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <configuration>
          <configOptions>
            <generateJsonIncludeAnnotations>true</generateJsonIncludeAnnotations>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>common</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/contracts/control-api.openapi.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/common</output>
              <modelPackage>lab.contracts.common.model</modelPackage>
              <generateApis>false</generateApis>
              <modelsToGenerate>Problem</modelsToGenerate>
            </configuration>
          </execution>
          <execution>
            <id>control</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/contracts/control-api.openapi.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/control</output>
              <apiPackage>lab.contracts.control.api</apiPackage>
              <modelPackage>lab.contracts.control.model</modelPackage>
              <generateApis>false</generateApis>
              <generateModels>true</generateModels>
              <schemaMappings>
                <schemaMapping>Incident=lab.contracts.detector.model.Incident</schemaMapping>
                <schemaMapping>Problem=lab.contracts.common.model.Problem</schemaMapping>
              </schemaMappings>
            </configuration>
          </execution>
          <execution>
            <id>detector</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/contracts/detector-api.openapi.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/detector</output>
              <apiPackage>lab.contracts.detector.api</apiPackage>
              <modelPackage>lab.contracts.detector.model</modelPackage>
              <schemaMappings>
                <schemaMapping>Problem=lab.contracts.common.model.Problem</schemaMapping>
              </schemaMappings>
              <generateApis>false</generateApis>
              <generateModels>true</generateModels>
            </configuration>
          </execution>
          <execution>
            <id>runtime</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${maven.multiModuleProjectDirectory}/contracts/runtime-api.openapi.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/runtime</output>
              <apiPackage>lab.contracts.runtime.api</apiPackage>
              <modelPackage>lab.contracts.runtime.model</modelPackage>
              <schemaMappings>
                <schemaMapping>Problem=lab.contracts.common.model.Problem</schemaMapping>
              </schemaMappings>
              <generateApis>false</generateApis>
              <generateModels>true</generateModels>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

