erDiagram
    %% Logical event references are documented separately.
    control_experiments {
        uuid id PK "required"
        varchar name "required"
        integer definition_version "required"
        jsonb definition "required"
        bytea definition_hash "required"
        bigint seed "required"
        timestamptz business_time_base "required"
        timestamptz created_at "required"
    }
    control_runs {
        uuid id PK "required"
        uuid experiment_id FK "required"
        varchar target "required"
        integer repetition "required"
        uuid partition_id "required"
        varchar state "required"
        bigint revision "required"
        boolean cleanup_safe "required"
        text failure_reason "nullable"
        timestamptz created_at "required"
        timestamptz finished_at "nullable"
        jsonb fixture_manifest "nullable"
        bytea fixture_hash "nullable"
        jsonb command_journal "required"
    }
    control_runner_jobs {
        uuid id PK "required"
        uuid run_id FK "required"
        uuid epoch "required"
        integer attempt "required"
        jsonb plan "required"
        bytea plan_hash "required"
        bytea lease_token_hash "required"
        timestamptz lease_expires_at "required"
        varchar state "required"
        jsonb step_manifest "nullable"
        bytea step_manifest_hash "nullable"
        timestamptz sealed_at "nullable"
    }
    control_attempts {
        uuid request_id PK "required"
        uuid step_id "required"
        integer attempt_no "required"
        timestamptz started_at "required"
        timestamptz finished_at "nullable"
        integer http_status "nullable"
        text transport_outcome "required"
        jsonb response_evidence "required"
        uuid job_id FK "required"
    }
    control_reports {
        uuid id PK "required"
        uuid run_id FK "required"
        integer revision "required"
        text evaluator_version "required"
        text completeness "required"
        jsonb body "required"
        bytea body_hash "required"
        timestamptz created_at "required"
        jsonb snapshot "nullable"
        bytea snapshot_hash "nullable"
        timestamptz snapshot_captured_at "nullable"
    }
    audit_producer_epochs {
        uuid id PK "required"
        uuid run_id FK "required"
        uuid partition_id "required"
        text producer_kind "required"
        text source "required"
        text state "required"
        timestamptz registered_at "required"
        uuid_array expected_event_ids "nullable"
        bytea event_set_hash "nullable"
        jsonb coverage "nullable"
        timestamptz sealed_at "nullable"
    }
    audit_security_events {
        uuid id PK "required"
        uuid producer_epoch FK "required"
        uuid run_id FK "required"
        uuid partition_id "required"
        uuid request_id "required"
        char trace_id "required"
        timestamptz occurred_at "required"
        timestamptz received_at "required"
        jsonb payload "required"
        bytea payload_hash "required"
    }
    audit_receipts {
        uuid request_id PK "required"
        uuid producer_epoch FK "required"
        uuid started_event_id FK "required"
        uuid terminal_event_id FK "nullable"
        boolean shop_invoked "required"
        timestamptz accepted_at "required"
        timestamptz completed_at "nullable"
    }
    detection_partitions {
        uuid id PK "required"
        bytea ruleset_hash "required"
        jsonb ruleset_snapshot "required"
        uuid lease_owner "nullable"
        timestamptz lease_until "nullable"
        bigint fence "required"
    }
    detection_jobs {
        uuid id PK "required"
        uuid partition_id FK "required"
        bytea ruleset_hash "required"
        text kind "required"
        text state "required"
        bytea manifest_hash "nullable"
        bigint expected_count "nullable"
        bigint processed_count "nullable"
        jsonb errors "required"
        timestamptz created_at "required"
        timestamptz finished_at "nullable"
        uuid_array expected_event_ids "nullable"
    }
    detection_processed_events {
        uuid partition_id PK,FK "required"
        bytea ruleset_hash PK "required"
        uuid event_id PK "required"
        timestamptz processed_at "required"
    }
    detection_rule_state {
        uuid partition_id PK,FK "required"
        bytea ruleset_hash PK "required"
        text rule_id PK "required"
        text correlation_key PK "required"
        text window_key PK "required"
        jsonb state "required"
        timestamptz updated_at "required"
    }
    detection_incidents {
        uuid id PK "required"
        uuid partition_id FK "required"
        bytea ruleset_hash "required"
        text rule_id "required"
        integer rule_version "required"
        text detector_version "required"
        text correlation_key "required"
        text window_key "required"
        text category "required"
        text technique "required"
        text_array tags "required"
        text severity "required"
        text confidence_level "required"
        text method "required"
        text analysis_state "required"
        text status "required"
        bigint revision "required"
        text impact_status "required"
        jsonb summary "required"
        timestamptz created_at "required"
        timestamptz detected_at "required"
        timestamptz updated_at "required"
        uuid_array evidence_event_ids "required"
        jsonb history "required"
    }
    control_experiments ||--o{ control_runs : "experiment_id"
    control_runs ||--o{ control_runner_jobs : "run_id"
    control_runner_jobs ||--o{ control_attempts : "job_id"
    control_runs ||--o{ control_reports : "run_id"
    control_runs ||--o{ audit_producer_epochs : "run_id"
    audit_producer_epochs ||--o{ audit_security_events : "producer_epoch"
    control_runs ||--o{ audit_security_events : "run_id"
    audit_producer_epochs ||--o{ audit_receipts : "producer_epoch"
    audit_security_events ||--o{ audit_receipts : "started_event_id"
    audit_security_events |o--o{ audit_receipts : "terminal_event_id"
    detection_partitions ||--o{ detection_jobs : "partition_id"
    detection_partitions ||--o{ detection_processed_events : "partition_id"
    detection_partitions ||--o{ detection_rule_state : "partition_id"
    detection_partitions ||--o{ detection_incidents : "partition_id"
