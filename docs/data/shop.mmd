erDiagram
    %% Generated. Logical event references are documented separately.
    users {
        bigint id PK "required"
        varchar login "required"
        varchar name "required"
        varchar email "required"
        varchar password_hash "required"
    }
    products {
        bigint id PK "required"
        varchar name "required"
        text description "required"
        bigint price "required"
        boolean published "required"
    }
    coupons {
        bigint id PK "required"
        varchar code "required"
        integer discount_percent "required"
        timestamptz expires_at "required"
        bigint max_uses "required"
        bigint used_count "required"
    }
    carts {
        bigint id PK "required"
        bigint user_id FK "required"
        bigint coupon_id FK "nullable"
        bigint revision "required"
        timestamptz updated_at "required"
    }
    cart_items {
        bigint cart_id PK,FK "required"
        bigint product_id PK,FK "required"
        integer quantity "required"
    }
    orders {
        bigint id PK "required"
        bigint user_id FK "required"
        bigint cart_id FK "required"
        bigint cart_revision "required"
        varchar status "required"
        bigint subtotal "required"
        bigint discount "required"
        bigint total "required"
        bigint coupon_id FK "nullable"
        timestamptz created_at "required"
        bytea idempotency_key_hash "required"
        bytea request_fingerprint "required"
        jsonb response_body "required"
    }
    order_items {
        bigint order_id PK,FK "required"
        bigint product_id PK,FK "required"
        integer quantity "required"
        bigint unit_price "required"
    }
    users ||--o| carts : "user_id"
    coupons |o--o{ carts : "coupon_id"
    carts ||--o{ cart_items : "cart_id"
    products ||--o{ cart_items : "product_id"
    users ||--o{ orders : "user_id"
    carts ||--o{ orders : "cart_id"
    coupons |o--o{ orders : "coupon_id"
    orders ||--o{ order_items : "order_id"
    products ||--o{ order_items : "product_id"
