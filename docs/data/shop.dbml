// Generated physical model; business-only constraints in shop-protected.sql.
// Cross-database references are logical and are not rendered as FK.
Table users {
  id bigint [pk, not null, increment, note: 'Идентификатор пользователя']
  login varchar(32) [not null, note: 'Нормализованный login']
  name varchar(100) [not null, note: 'Отображаемое имя']
  email varchar(254) [not null, note: 'Нормализованный email']
  password_hash varchar(255) [not null, note: 'PasswordEncoder hash; недоступен evaluator']
  indexes {
    (login) [unique]
    (email) [unique]
  }
  Note: 'Учетная запись; пользователя и корзину атомарно создаёт регистрация или fixture-модуль.'
}
Table products {
  id bigint [pk, not null, increment, note: 'Идентификатор товара']
  name varchar(120) [not null, note: 'Название']
  description text [not null, default: `''`, note: 'Описание']
  price bigint [not null, note: 'Цена в целых рублях']
  published boolean [not null, default: `false`, note: 'Видимость в нормативном API']
  indexes {
  }
  Note: 'Каталог неизменяем внутри run и до сохранения отчета.'
}
Table coupons {
  id bigint [pk, not null, increment, note: 'Идентификатор купона']
  code varchar(32) [not null, note: 'Нормализованный код']
  discount_percent integer [not null, note: 'Процент скидки']
  expires_at timestamptz [not null, note: 'Исключительная граница по бизнес-часам']
  max_uses bigint [not null, note: 'Лимит погашений']
  used_count bigint [not null, default: `0`, note: 'Счетчик погашений']
  indexes {
    (code) [unique]
  }
  Note: 'Условия неизменяемы внутри run; used_count меняется при оформлении.'
}
Table carts {
  id bigint [pk, not null, increment, note: 'Идентификатор корзины']
  user_id bigint [not null, note: 'Владелец']
  coupon_id bigint [note: 'Выбранный купон']
  revision bigint [not null, default: `0`, note: 'Версия после фактического изменения']
  updated_at timestamptz [not null, note: 'Бизнес-время изменения']
  indexes {
    (user_id) [unique]
    (coupon_id)
  }
  Note: 'Не более одной корзины на пользователя; наличие обеспечивает регистрация или fixture-модуль.'
}
Table cart_items {
  cart_id bigint [not null, note: 'Корзина']
  product_id bigint [not null, note: 'Товар']
  quantity integer [not null, note: 'Количество; бизнес-границы только protected']
  indexes {
    (cart_id, product_id) [pk]
    (product_id)
  }
  Note: 'Позиции текущей корзины.'
}
Table orders {
  id bigint [pk, not null, increment, note: 'Идентификатор заказа']
  user_id bigint [not null, note: 'Владелец']
  cart_id bigint [not null, note: 'Исходная корзина']
  cart_revision bigint [not null, note: 'Потребленная версия корзины']
  status varchar(16) [not null, default: `'CREATED'`, note: 'Единственный статус версии 1']
  subtotal bigint [not null, note: 'Стоимость до скидки']
  discount bigint [not null, note: 'Скидка в рублях']
  total bigint [not null, note: 'Итог в рублях']
  coupon_id bigint [note: 'Купон; NULL означает отсутствие скидки']
  created_at timestamptz [not null, note: 'Бизнес-время принятия решения checkout']
  idempotency_key_hash bytea [not null, note: 'HMAC-SHA256 исходного key; scope POST /orders + user']
  request_fingerprint bytea [not null, note: 'SHA-256 канонического request с версией и route']
  response_body jsonb [not null, note: 'Сохраненный Order response; status всегда 201']
  indexes {
    (user_id, created_at, id)
    (cart_id, cart_revision)
    (coupon_id)
    (user_id, idempotency_key_hash)
  }
  Note: 'Неизменяемый эффект checkout, успешный ответ и погашение купона; один купон на заказ, отмен нет.'
}
Table order_items {
  order_id bigint [not null, note: 'Заказ']
  product_id bigint [not null, note: 'Исходный товар']
  quantity integer [not null, note: 'Количество']
  unit_price bigint [not null, note: 'Цена при оформлении']
  indexes {
    (order_id, product_id) [pk]
    (product_id)
  }
  Note: 'Неизменяемые позиции заказа с ценой на момент оформления.'
}
Ref: carts.user_id > users.id [delete: restrict]
Ref: carts.coupon_id > coupons.id [delete: restrict]
Ref: cart_items.cart_id > carts.id [delete: cascade]
Ref: cart_items.product_id > products.id [delete: restrict]
Ref: orders.user_id > users.id [delete: restrict]
Ref: orders.cart_id > carts.id [delete: restrict]
Ref: orders.coupon_id > coupons.id [delete: restrict]
Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.product_id > products.id [delete: restrict]
